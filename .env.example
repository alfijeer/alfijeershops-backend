# ══════════════════════════════════════════════════════════
# ALFIJEER BACKEND — environment variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ══════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alfijeer?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=https://alfijeer.com,http://localhost:3000,http://127.0.0.1:5500

# File uploads — Cloudinary (find these three on your Cloudinary dashboard homepage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_SIZE_MB=5

# Password reset emails — sent via Resend's HTTPS API, not SMTP
# (Railway blocks outbound SMTP on free/hobby plans). Sign up free
# at resend.com to get RESEND_API_KEY.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=ALFIJEER <onboarding@resend.dev>

# Your live frontend URL — used to build the link inside reset-password emails
FRONTEND_URL=https://arewa-square-frontend.vercel.app
